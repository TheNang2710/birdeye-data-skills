# Local development only — copy to `.env` (dev.py loads it automatically).
#
# On a Vercel deployment you normally leave these UNSET: the visitor pastes
# their own Birdeye key in the UI and the server env key is ignored.

BIRDEYE_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Allow the server env key to be used on a real deployment (private deploys).
# BIRDEYE_ALLOW_ENV_KEY=1
# Per-run subprocess budget in seconds (keep below maxDuration in vercel.json).
# BIRDEYE_TIMEOUT_S=55
# Writable scratch dir — serverless filesystems are read-only outside /tmp.
# BIRDEYE_SCRATCH_DIR=/tmp/birdeye
