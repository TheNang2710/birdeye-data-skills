{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "functions": {
    "api/run.py": {
      "maxDuration": 60,
      "includeFiles": "{api/**,birdeye_cli.py,modules/**,skills/**}"
    },
    "api/meta.py": {
      "maxDuration": 15,
      "includeFiles": "{api/**,birdeye_cli.py,modules/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
